# =====================================================================
# .env.example – Vorlage für die Zugangsdaten
#
# Lokal:  Datei nach ".env.local" kopieren und Werte eintragen.
# Vercel: Dieselben Namen unter Project → Settings → Environment Variables eintragen.
# Die echten Werte NIE auf GitHub hochladen (.env.local ist in .gitignore).
#
# Die Quizze laufen auch ganz ohne diese Werte. Supabase braucht nur die Bestenliste.
# =====================================================================

# Supabase → Project Settings → API (bzw. „Connect“ → App Frameworks → Next.js)
# Der "anon"- bzw. "publishable"-Schlüssel darf öffentlich sein.
# Den "service_role"- bzw. "secret"-Schlüssel hier NIEMALS eintragen!
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Statt NEXT_PUBLIC_SUPABASE_ANON_KEY geht auch NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
